<Layouts.flash_group flash={@flash} />

<div class="relative isolate min-h-screen overflow-hidden bg-base-100">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -top-24 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-primary/10 blur-3xl" />
  </div>

  <div class="relative mx-auto w-full max-w-6xl px-4 pb-24 pt-8 sm:px-6 sm:pb-28 sm:pt-10 lg:px-8 lg:pb-32 lg:pt-12">
    <header id="landing-navbar" class="mx-auto max-w-5xl">
      <div class="navbar rounded-box border border-base-300 bg-base-100/90 px-3 shadow-sm backdrop-blur md:px-5">
        <div class="navbar-start">
          <.link href={~p"/"} class="text-lg font-semibold tracking-tight">
            Caracol
          </.link>
        </div>

        <div class="navbar-center hidden md:flex">
          <ul class="menu menu-horizontal gap-1 px-1">
            <li><a href="#landing-hero">Overview</a></li>
            <li><a href="#landing-features">Features</a></li>
            <li><a href="#landing-companies">Companies</a></li>
            <li><a href="#landing-testimonials">Testimonials</a></li>
            <li><a href="#landing-technology">Technology</a></li>
            <li><a href="#landing-cta">Launch</a></li>
          </ul>
        </div>

        <div class="navbar-end gap-2">
          <.theme_dropdown id="home-theme-dropdown" />

          <%= if @current_scope do %>
            <.link href={~p"/home"} class="btn btn-sm btn-primary">
              <.icon name="hero-command-line" class="size-4" /> Open home
            </.link>
            <.link href={~p"/users/log-out"} method="delete" class="btn btn-sm btn-outline">
              <.icon name="hero-arrow-right-start-on-rectangle" class="size-4" /> Log out
            </.link>
          <% else %>
            <.link href={~p"/users/register"} class="btn btn-sm btn-ghost">
              Register
            </.link>
            <.link href={~p"/users/log-in"} class="btn btn-sm btn-primary">
              Log in
            </.link>
          <% end %>
        </div>
      </div>
    </header>

    <section id="landing-hero" class="mx-auto mt-16 max-w-4xl text-center sm:mt-24 lg:mt-28">
      <div class="badge badge-outline gap-2 px-4 py-3">
        <.icon name="hero-sparkles" class="size-4 opacity-70" /> Generic project starter
      </div>
      <h1 class="mt-7 text-4xl font-black tracking-tight sm:text-6xl lg:text-7xl">
        Build your next idea with a landing page that feels ready on day one.
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-base-content/75">
        Ship a polished front door for any new project, with auth links, opinionated structure, and clean
        components you can customize in minutes.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <%= if @current_scope do %>
          <.link
            href={~p"/users/settings"}
            class="btn btn-primary btn-wide transition hover:-translate-y-0.5"
          >
            <.icon name="hero-cog-6-tooth" class="size-4" /> Open account settings
          </.link>
        <% else %>
          <.link
            href={~p"/users/register"}
            class="btn btn-primary btn-wide transition hover:-translate-y-0.5"
          >
            <.icon name="hero-user-plus" class="size-4" /> Create an account
          </.link>
          <.link
            href={~p"/users/log-in"}
            class="btn btn-outline btn-wide transition hover:-translate-y-0.5"
          >
            <.icon name="hero-arrow-right-on-rectangle" class="size-4" /> Log in
          </.link>
        <% end %>
      </div>
    </section>

    <section id="landing-features" class="mx-auto mt-20 max-w-5xl sm:mt-24 lg:mt-28">
      <div class="grid gap-6 md:grid-cols-3">
        <article class="card border border-base-300 bg-base-100 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-md">
          <div class="card-body gap-3">
            <div class="badge badge-outline">Fast Setup</div>
            <h2 class="card-title gap-2">
              <.icon name="hero-bolt" class="size-5 text-base-content/70" />
              Start with clear defaults
            </h2>
            <p class="text-sm leading-7 text-base-content/75">
              Swap copy and colors, keep the structure, and launch your product page without rebuilding base UI.
            </p>
          </div>
        </article>

        <article class="card border border-base-300 bg-base-100 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-md">
          <div class="card-body gap-3">
            <div class="badge badge-outline">Built-In Auth</div>
            <h2 class="card-title gap-2">
              <.icon name="hero-lock-closed" class="size-5 text-base-content/70" />
              Visitor-aware actions
            </h2>
            <p class="text-sm leading-7 text-base-content/75">
              Anonymous users see Register and Log in, while signed-in users get account context and quick exit.
            </p>
          </div>
        </article>

        <article class="card border border-base-300 bg-base-100 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-md">
          <div class="card-body gap-3">
            <div class="badge badge-outline">Production Friendly</div>
            <h2 class="card-title gap-2">
              <.icon name="hero-cpu-chip" class="size-5 text-base-content/70" />
              Polished by default
            </h2>
            <p class="text-sm leading-7 text-base-content/75">
              Designed with Tailwind and daisyUI primitives for responsive behavior and smooth micro-interactions.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="mx-auto mt-12 max-w-5xl sm:mt-16">
      <div class="rounded-box border border-base-300 bg-base-200 p-5 sm:p-6">
        <div class="flex flex-wrap items-center justify-center gap-3 text-sm text-base-content/85">
          <span class="badge badge-outline">Auth Ready</span>
          <span class="badge badge-outline">LiveView Compatible</span>
          <span class="badge badge-outline">Responsive Layout</span>
          <span class="badge badge-outline">Reusable Sections</span>
          <span class="badge badge-outline">Deploy Friendly</span>
        </div>
      </div>
    </section>

    <section id="landing-companies" class="mx-auto mt-20 max-w-5xl sm:mt-24">
      <div class="text-center">
        <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-base-content/60">
          <.icon name="hero-building-office-2" class="size-4" /> Used by companies
        </p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
          Trusted by ambitious teams launching new products.
        </h2>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        <div class="badge badge-lg h-14 w-full border-base-300 bg-base-200 py-4 text-center text-base font-semibold text-base-content/80 transition hover:bg-base-300">
          Northstar Labs
        </div>
        <div class="badge badge-lg h-14 w-full border-base-300 bg-base-200 py-4 text-center text-base font-semibold text-base-content/80 transition hover:bg-base-300">
          Helix Cloud
        </div>
        <div class="badge badge-lg h-14 w-full border-base-300 bg-base-200 py-4 text-center text-base font-semibold text-base-content/80 transition hover:bg-base-300">
          Atlas Commerce
        </div>
        <div class="badge badge-lg h-14 w-full border-base-300 bg-base-200 py-4 text-center text-base font-semibold text-base-content/80 transition hover:bg-base-300">
          Meadow Health
        </div>
        <div class="badge badge-lg h-14 w-full border-base-300 bg-base-200 py-4 text-center text-base font-semibold text-base-content/80 transition hover:bg-base-300">
          Polar Systems
        </div>
        <div class="badge badge-lg h-14 w-full border-base-300 bg-base-200 py-4 text-center text-base font-semibold text-base-content/80 transition hover:bg-base-300">
          Vanta Works
        </div>
      </div>
    </section>

    <section id="landing-testimonials" class="mx-auto mt-20 max-w-5xl sm:mt-24">
      <div class="text-center">
        <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-base-content/60">
          <.icon name="hero-chat-bubble-left-right" class="size-4" /> Testimonials
        </p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
          Teams move faster when the first experience is already polished.
        </h2>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        <article class="card border border-base-300 bg-base-100 shadow-sm">
          <div class="card-body gap-4">
            <p class="leading-7 text-base-content/80">
              "We launched our preview page in a day and spent the rest of the week focused on product discovery."
            </p>
            <div class="text-sm">
              <p class="font-semibold">Amelia Park</p>
              <p class="text-base-content/60">Product Lead, Northstar Labs</p>
            </div>
          </div>
        </article>

        <article class="card border border-base-300 bg-base-100 shadow-sm">
          <div class="card-body gap-4">
            <p class="leading-7 text-base-content/80">
              "Auth-aware navigation meant users always saw the right next step, which improved our onboarding flow."
            </p>
            <div class="text-sm">
              <p class="font-semibold">Devon Reyes</p>
              <p class="text-base-content/60">Engineering Manager, Helix Cloud</p>
            </div>
          </div>
        </article>

        <article class="card border border-base-300 bg-base-100 shadow-sm">
          <div class="card-body gap-4">
            <p class="leading-7 text-base-content/80">
              "The design system felt intentional out of the box. We shipped a page that looked custom, not generic."
            </p>
            <div class="text-sm">
              <p class="font-semibold">Priya Raman</p>
              <p class="text-base-content/60">Founder, Atlas Commerce</p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section id="landing-technology" class="mx-auto mt-20 max-w-5xl sm:mt-24">
      <div class="text-center">
        <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-base-content/60">
          <.icon name="hero-wrench-screwdriver" class="size-4" /> Technology
        </p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
          Modern stack, practical defaults, fast delivery.
        </h2>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <article class="card border border-base-300 bg-base-100 shadow-sm">
          <div class="card-body gap-3">
            <h3 class="card-title gap-2">
              <.icon name="hero-paint-brush" class="size-5 text-base-content/70" /> UI Layer
            </h3>
            <p class="text-sm leading-7 text-base-content/75">
              Tailwind + daisyUI give you flexible components and consistent design tokens from the first commit.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="badge badge-outline">Tailwind CSS</span>
              <span class="badge badge-outline">daisyUI</span>
              <span class="badge badge-outline">HEEx</span>
            </div>
          </div>
        </article>

        <article class="card border border-base-300 bg-base-100 shadow-sm">
          <div class="card-body gap-3">
            <h3 class="card-title gap-2">
              <.icon name="hero-server-stack" class="size-5 text-base-content/70" />
              Backend Runtime
            </h3>
            <p class="text-sm leading-7 text-base-content/75">
              Phoenix and Elixir on the BEAM provide resilient real-time capabilities with clear conventions.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="badge badge-outline">Phoenix</span>
              <span class="badge badge-outline">Elixir</span>
              <span class="badge badge-outline">BEAM VM</span>
            </div>
          </div>
        </article>

        <article class="card border border-base-300 bg-base-100 shadow-sm">
          <div class="card-body gap-3">
            <h3 class="card-title gap-2">
              <.icon name="hero-shield-check" class="size-5 text-base-content/70" />
              Auth Foundation
            </h3>
            <p class="text-sm leading-7 text-base-content/75">
              Built on generated auth flows so public and authenticated journeys are separated and reliable.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="badge badge-outline">Magic Link</span>
              <span class="badge badge-outline">Scoped Sessions</span>
              <span class="badge badge-outline">Secure Routing</span>
            </div>
          </div>
        </article>

        <article class="card border border-base-300 bg-base-100 shadow-sm">
          <div class="card-body gap-3">
            <h3 class="card-title gap-2">
              <.icon name="hero-rocket-launch" class="size-5 text-base-content/70" />
              Delivery Ready
            </h3>
            <p class="text-sm leading-7 text-base-content/75">
              Opinionated defaults keep local development, testing, and deployment paths straightforward.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="badge badge-outline">Mix Tasks</span>
              <span class="badge badge-outline">Phoenix LiveView</span>
              <span class="badge badge-outline">CI Friendly</span>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section id="landing-cta" class="mx-auto mt-20 max-w-5xl sm:mt-24 lg:mt-28">
      <div class="hero rounded-box border border-base-300 bg-base-100 shadow-sm">
        <div class="hero-content py-12 text-center sm:py-14">
          <div class="max-w-xl space-y-5">
            <h2 class="text-3xl font-bold">
              Your next project can start with a better first impression.
            </h2>
            <p class="leading-7 text-base-content/75">
              Keep this as your default launch surface and focus your effort on product value, not repeated page setup.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-3 pt-3">
              <%= if @current_scope do %>
                <.link href={~p"/users/settings"} class="btn btn-primary">
                  <.icon name="hero-cog-6-tooth" class="size-4" /> Go to settings
                </.link>
                <.link href={~p"/users/log-out"} method="delete" class="btn btn-outline">
                  <.icon name="hero-arrow-right-start-on-rectangle" class="size-4" /> Log out
                </.link>
              <% else %>
                <.link href={~p"/users/register"} class="btn btn-primary">
                  <.icon name="hero-user-plus" class="size-4" /> Register now
                </.link>
                <.link href={~p"/users/log-in"} class="btn btn-outline">
                  <.icon name="hero-arrow-right-on-rectangle" class="size-4" /> Log in
                </.link>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
